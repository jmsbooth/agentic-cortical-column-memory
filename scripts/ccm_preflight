#!/usr/bin/env python3
"""Run CCM-EMP-002 preflight locally; output is deterministic and not evidence of model quality."""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from evaluation.empirical.preflight import assess_configuration


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=Path, default=Path("preregistration/registered-configs/ccm-v0.1.0.json"))
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    config_file = args.config if args.config.is_absolute() else ROOT / args.config
    try:
        config = json.loads(config_file.read_text(encoding="utf-8"))
        result = assess_configuration(config, root=ROOT)
    except (OSError, ValueError) as error:
        result = {"protocol_id": "CCM-EMP-002", "ok": False, "eligible_for_empirical": False,
                  "checks": [{"id": "config_read", "status": "blocked", "detail": str(error)}]}
    output = json.dumps(result, indent=2, sort_keys=True) + "\n"
    print(output, end="")
    if args.output:
        destination = args.output if args.output.is_absolute() else ROOT / args.output
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(output, encoding="utf-8")
    return 0 if result["ok"] else 2


if __name__ == "__main__":
    sys.exit(main())
